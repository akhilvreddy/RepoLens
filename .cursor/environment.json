{
  "name": "RepoLens",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ./.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --hostname 0.0.0.0 --port 3000"
    }
  ],
  "ports": [3000, 8000]
}
